---
import { siteTitle } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div>
    <strong>{siteTitle}</strong>
    <p>A physical-digital studio for quiet thoughts, pinned excerpts, archival ephemera, and independent musings.</p>
  </div>
  <span class="footer-note"><a href="/notes/">NOTES ARCHIVE</a>　•　EST. STUDIO JOURNAL　•　ALL SCRAPS PRESERVED　•　{year}</span>
</footer>

<style>
  .site-footer { display: flex; justify-content: space-between; gap: var(--space-8); padding: var(--space-10) 0; border-top: var(--border-paper); color: var(--color-ink-secondary); }
  .site-footer strong { color: var(--color-accent-terracotta); font-size: 1.1rem; font-weight: 500; }
  .site-footer p { max-width: 28rem; margin: var(--space-2) 0 0; font-size: 0.9rem; }
  .footer-note { align-self: center; color: var(--color-ink-muted); font: 0.6rem/1.4 var(--font-mono); letter-spacing: 0.08em; }
  @media (max-width: 640px) { .site-footer { flex-direction: column; padding: var(--space-8) 0; } .footer-note { align-self: start; } }
</style>
