---
import ThemeToggle from './ThemeToggle.astro';
import { siteTitle, navItems } from '../config';

interface Props { currentPath?: string; }
const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-title">
      <span class="site-mark" aria-hidden="true">✣</span>
      <span>{siteTitle}</span>
    </a>

    <nav class="site-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
          return <li><a href={item.href} class:list={{ 'nav-link-active': isActive }} aria-current={isActive ? 'page' : undefined}>{item.label}</a></li>;
        })}
      </ul>
      <div class="nav-actions">
        <a href="/rss.xml" class="rss-link">↗ <span>RSS</span></a>
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header { padding: var(--space-4) 0; border-bottom: var(--border-paper); background: rgba(252, 249, 243, 0.88); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .site-title { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-accent-terracotta); font-size: 1.15rem; text-decoration: none; white-space: nowrap; }
  .site-title:hover { color: var(--color-accent-terracotta); }
  .site-mark { display: grid; place-items: center; width: 1.65rem; height: 1.65rem; border: 1px dashed var(--color-accent-terracotta); font-size: 1.1rem; transform: rotate(-8deg); }
  .site-nav, .nav-list, .nav-actions { display: flex; align-items: center; }
  .site-nav { gap: var(--space-6); }
  .nav-list { gap: 0.35rem; list-style: none; }
  .nav-list a, .rss-link { padding: 0.4rem 0.7rem; color: var(--color-ink-secondary); font: 0.625rem/1 var(--font-mono); letter-spacing: 0.08em; text-decoration: none; text-transform: uppercase; background: var(--color-surface-container); }
  .nav-list a:hover, .nav-list a.nav-link-active { color: var(--color-accent-terracotta); background: var(--color-surface-container-high); }
  .nav-actions { gap: var(--space-2); }
  .rss-link { border: 1px dashed var(--color-ink-muted); background: transparent; }
  .rss-link:hover { color: var(--color-accent-terracotta); }
  :global(.theme-toggle) { width: 2rem !important; height: 2rem !important; border: 1px solid var(--color-ink-secondary) !important; border-radius: 50% !important; background: transparent !important; }
  @media (max-width: 760px) {
    .site-header { padding: var(--space-3) 0; }
    .header-inner { align-items: flex-start; flex-direction: column; }
    .site-nav { width: 100%; justify-content: space-between; gap: var(--space-2); }
    .nav-list { overflow-x: auto; }
    .nav-list a { white-space: nowrap; }
    .rss-link span { display: none; }
  }
</style>
