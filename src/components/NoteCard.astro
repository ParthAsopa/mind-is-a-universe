---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/formatDate';

interface Props {
  note: CollectionEntry<'notes'>;
  featured?: boolean;
}

const { note, featured = false } = Astro.props;
---

<a class:list={['note-card', { featured }]} href="/notes/">
  <span class="note-heading"><span>Stick Memo</span><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time></span>
  <h2>{note.data.title}</h2>
  <p>“{note.data.text}”</p>
  <span class="note-footer"><span>⌑ Keep handy</span><strong>SCRAP #{note.id.slice(-2).toUpperCase()}</strong></span>
</a>

<style>
  .note-card {
    display: block;
    position: relative;
    padding: var(--space-5);
    color: var(--color-ink-primary);
    background: #fff2bc;
    box-shadow: var(--shadow-paper);
    text-decoration: none;
    transform: rotate(1.5deg);
    transition: transform var(--transition-timing), box-shadow var(--transition-timing);
  }

  .note-card:hover {
    color: var(--color-ink-primary);
    transform: translateY(-3px) rotate(0.5deg);
    box-shadow: var(--shadow-lifted);
  }

  .note-card::before {
    content: '';
    position: absolute;
    top: -0.45rem;
    right: 2rem;
    width: 64px;
    height: 18px;
    background: rgba(220, 210, 190, 0.65);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    transform: rotate(-8deg);
  }

  .note-heading, .note-footer {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--color-ink-secondary);
    font: 0.6rem var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .note-card h2 {
    margin: var(--space-5) 0 var(--space-2);
    color: var(--color-ink-primary);
    font-size: 1.3rem;
  }

  .note-card p {
    margin-bottom: var(--space-6);
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .note-footer strong { color: var(--color-ink-secondary); }
  @media (max-width: 560px) { .note-heading, .note-footer { align-items: start; flex-direction: column; } }
</style>
