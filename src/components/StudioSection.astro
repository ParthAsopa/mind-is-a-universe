---
interface Props {
  eyebrow: string;
  title: string;
  detail?: string;
}

const { eyebrow, title, detail } = Astro.props;
---

<header class="studio-section-header">
  <div>
    <span class="studio-eyebrow">{eyebrow}</span>
    <h2>{title}</h2>
  </div>
  {detail && <span class="studio-detail">{detail}</span>}
</header>

<style>
  .studio-section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin: var(--space-12) 0 var(--space-4);
  }

  .studio-eyebrow,
  .studio-detail {
    color: var(--color-ink-muted);
    font: 0.625rem/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .studio-section-header h2 {
    margin: var(--space-1) 0 0;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  @media (max-width: 640px) {
    .studio-section-header { align-items: start; flex-direction: column; }
  }
</style>
