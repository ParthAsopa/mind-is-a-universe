---
// src/components/TagList.astro
import { slugify } from '../utils/slugify';

interface Props {
  tags: string[];
  activeTag?: string;
  counts?: Record<string, number>;
}

const { tags, activeTag, counts } = Astro.props;
---

<div class="tag-list">
  {tags.map((tag) => {
    const slug = slugify(tag);
    const isActive = activeTag === tag || activeTag === slug;
    const count = counts?.[tag];
    return (
      <a
        href={`/tags/${slug}/`}
        class:list={['tag-badge', { 'tag-active': isActive }]}
      >
        <span class="tag-hash">#</span>
        <span class="tag-name">{tag}</span>
        {count !== undefined && <span class="tag-count">({count})</span>}
      </a>
    );
  })}
</div>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .tag-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    color: var(--color-tag-text);
    background-color: var(--color-tag-bg);
    border: 1px solid var(--color-tag-border);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--transition-timing),
      color var(--transition-timing), border-color var(--transition-timing);
  }

  .tag-badge:hover {
    background-color: var(--color-tag-hover-bg);
    border-color: var(--color-border-hover);
    color: var(--color-primary);
    text-decoration: none;
  }

  .tag-badge.tag-active {
    background-color: var(--color-accent-subtle);
    border-color: var(--color-accent);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
  }

  .tag-hash {
    opacity: 0.6;
  }

  .tag-count {
    opacity: 0.75;
    font-size: 0.9em;
  }
</style>
