---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/formatDate';
import { getReadingTime } from '../utils/readingTime';
import ArchiveLabel from './ArchiveLabel.astro';
import PaperTape from './PaperTape.astro';
import { slugify } from '../utils/slugify';

interface Props { post: CollectionEntry<'posts'>; featured?: boolean; index?: number; }
const { post, featured = false, index = 0 } = Astro.props;
const readingTime = getReadingTime(post.body);
const images = [
  'https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=1000&q=80',
  'https://images.unsplash.com/photo-1511108690759-009c5a4c4aab?auto=format&fit=crop&w=1000&q=80',
  'https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1000&q=80',
];
const image = images[index % images.length];
---

<article class:list={['post-card', { featured, 'post-card-even': index % 2 === 0 }]}>
  <PaperTape tone={index % 3 === 0 ? 'sage' : index % 3 === 1 ? 'neutral' : 'blue'} class="tape" />
  {featured && <img class="post-image" src={image} alt="" loading="lazy" />}
  <div class="post-card-body">
    <div class="post-meta">
      <ArchiveLabel tone={index % 2 ? 'sage' : 'terracotta'}>Essay No. {String(index + 28).padStart(2, '0')}</ArchiveLabel>
      <span>{formatDate(post.data.date)} · {readingTime}</span>
    </div>
    <h2 class="post-title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
    <p class="post-description">{post.data.description}</p>
    <div class="post-footer-row">
      <div class="post-tags">{post.data.tags.map((tag) => <a href={`/tags/${slugify(tag)}/`}>#{tag}</a>)}</div>
      <a class="read-link" href={`/posts/${post.id}/`}>Read post →</a>
    </div>
  </div>
</article>

<style>
  .post-card { position: relative; overflow: visible; background: var(--color-surface-paper); box-shadow: var(--shadow-paper); transform: rotate(-0.7deg); transition: transform var(--transition-timing), box-shadow var(--transition-timing); }
    .post-card { position: relative; isolation: isolate; overflow: visible; background: var(--color-surface-paper); box-shadow: var(--shadow-paper); transform: rotate(-0.7deg); transition: transform var(--transition-timing), box-shadow var(--transition-timing); }
  .post-card-even { transform: rotate(0.7deg); }
  .post-card:hover { z-index: 3; transform: translateY(-3px) rotate(0deg); box-shadow: var(--shadow-lifted); }
  .tape { top: -0.55rem; left: 2rem; }
  .post-card-body, .post-image { position: relative; z-index: 1; }
    .post-card-body { padding: var(--space-5); }
  .post-image { display: block; width: 100%; height: 220px; object-fit: cover; filter: saturate(0.75) sepia(0.12); }
  .post-meta, .post-tags, .read-link { font: 0.625rem/1.4 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .post-meta { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); color: var(--color-ink-muted); }
  .post-title { margin: var(--space-3) 0 var(--space-2); font-size: clamp(1.45rem, 3vw, 2.1rem); }
  .post-title a { color: var(--color-ink-primary); text-decoration: none; }
  .post-title a:hover { color: var(--color-accent-terracotta); }
  .post-description { color: var(--color-ink-secondary); line-height: 1.55; }
  .post-footer-row { display: flex; justify-content: space-between; align-items: end; gap: var(--space-3); margin-top: var(--space-5); }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .post-tags a { color: var(--color-ink-muted); text-decoration: none; }
  .read-link { padding: 0.4rem 0.55rem; color: #fff; background: var(--color-accent-terracotta); text-decoration: none; white-space: nowrap; }
  .read-link:hover { color: #fff; background: var(--color-ink-primary); }
  @media (max-width: 560px) { .post-footer-row { align-items: start; flex-direction: column; } }
</style>
